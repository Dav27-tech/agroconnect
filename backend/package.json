{
  "name": "agroconnect-backend",
  "version": "1.0.0",
  "description": "AgroConnect Backend REST API - DRC Agricultural Marketplace",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsc && node -e \"process.env.NODE_ENV='test'; import('./test-routes.js')\" && node -e \"process.env.NODE_ENV='test'; import('./test-business-rules.js')\" && node ./test-cors.js",
    "admin:create": "npm run build && node scripts/create-admin.js",
    "superadmin:create": "npm run build && node scripts/create-super-admin.js",
    "db:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "agroconnect",
    "marketplace",
    "congo",
    "agriculture",
    "express",
    "prisma"
  ],
  "author": "AgroConnect Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "^8.0.0-rc.23",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
