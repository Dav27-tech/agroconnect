datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  BUYER
  SELLER
  DELIVERY_PROVIDER
  DELIVERY_PERSON
  ADMIN
}

enum SellerType {
  FARMER    // Agriculteur / Producteur direct
  RESELLER  // Revendeur indépendant (marchés urbains, grossistes)
  SUPPLIER  // Fournisseur d'intrants et d'équipements agricoles
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum Currency {
  CDF // Franc Congolais
  USD // Dollar Américain
}

enum UnitOfMeasure {
  KG
  SAC_25KG
  SAC_50KG
  SAC_100KG
  BOTTE
  TONNE
  PIECE
  LITRE
  BIDON_20L
  CARTON
  CASIER
}

enum SaleType {
  RETAIL    // Vente au détail
  WHOLESALE // Vente en gros
}

enum StockMovementType {
  INITIAL_STOCK           // Stock initial à la création
  RESTOCK                 // Réapprovisionnement par le vendeur
  ORDER_RESERVATION       // Réservation lors de la commande client
  ORDER_FULFILLMENT       // Déduction définitive après livraison
  ORDER_CANCELLED_RESTORE // Réintégration suite à annulation
  MANUAL_ADJUSTMENT       // Ajustement inventaire manuel par le vendeur
  SPOILAGE_LOSS           // Perte, avarie ou dépréciation signalée
}

enum ParentOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum SubOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  M_PESA
  ORANGE_MONEY
  AIRTEL_MONEY
  AFRIMONEY
  BANK_TRANSFER
  MANUAL_TEST
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id            String     @id @default(uuid())
  phoneNumber   String     @unique // Numéro congolais (ex: +243810000001)
  email         String?    @unique
  passwordHash  String
  fullName      String
  roles         UserRole[] @default([BUYER]) // Support multi-rôles natif
  isActive      Boolean    @default(true)
  preferredLang String     @default("fr")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  sellerProfile    SellerProfile?
  deliveryProfile  DeliveryProfile?
  parentOrders     ParentOrder[]    @relation("BuyerOrders")
  notifications    Notification[]
  carts            Cart[]

  @@map("users")
}

model SellerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerType         SellerType
  businessName       String
  description        String?
  province           String             // Province en RDC (ex: Kinshasa, Kwilu, Haut-Katanga, Nord-Kivu)
  city               String             // Ville ou territoire
  address            String?
  verificationStatus VerificationStatus @default(PENDING)
  commissionRate     Decimal            @default(5.00) // % commission AgroConnect
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  offers             Offer[]
  subOrders          SubOrder[]
  sellerServices     SellerService[]
  payouts            SellerPayout[]
  stockMovements     StockMovement[]
  financialRecords   FinancialRecord[]

  @@map("seller_profiles")
}

model DeliveryProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String?
  vehicleType    String?
  plateNumber    String?
  operatingArea  String             // Région d'opération (ex: Kinshasa - Gombe / Limete / Masina)
  isAvailable    Boolean            @default(true)
  status         VerificationStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deliveries     Delivery[]         @relation("PersonnelDeliveries")

  @@map("delivery_profiles")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique // ex: Tubercules & Racines, Céréales & Grains, Légumes & Maraîchage
  slug        String     @unique
  description String?
  imageUrl    String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id            String        @id @default(uuid())
  name          String        // Produit commun du catalogue (ex: Manioc Doux, Maïs Jaune)
  slug          String        @unique
  description   String?
  standardUnit  UnitOfMeasure @default(KG)
  scientificName String?
  imageUrl      String?
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  offers        Offer[]

  @@map("products")
}

model Offer {
  id                  String         @id @default(uuid())
  sellerId            String
  seller              SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId           String
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Stock unique et partagé entre la vente au détail et en gros (évite tout sur-stockage)
  stockQuantity       Decimal        @default(0.00)
  unit                UnitOfMeasure  @default(KG)
  isAvailable         Boolean        @default(true)
  
  // Vente au détail (Retail)
  retailPriceCdf      Decimal
  retailPriceUsd      Decimal
  retailMinQuantity   Decimal        @default(1.00)

  // Vente en gros (Wholesale)
  wholesalePriceCdf   Decimal?
  wholesalePriceUsd   Decimal?
  wholesaleMinQuantity Decimal?

  // Traçabilité et origine de la récolte
  harvestDate         DateTime?
  originProvince      String         // Ex: Kwilu, Haut-Katanga, Nord-Kivu
  originCity          String?        // Ex: Kikwit, Lubumbashi, Goma
  qualityGrade        String?        // Ex: Extra, Grade 1, Bio
  imageUrl            String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  orderItems          OrderItem[]
  services            OfferService[]
  stockMovements      StockMovement[]
  cartItems           CartItem[]

  @@map("offers")
}

model SellerService {
  id          String         @id @default(uuid())
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  serviceType String         // LIVRAISON_EXPRESS, CONDITIONNEMENT, CALIBRAGE_TRI, GARANTIE_FRAICHEUR
  title       String
  description String?
  extraFeeCdf Decimal        @default(0.00)
  extraFeeUsd Decimal        @default(0.00)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  offerServices OfferService[]

  @@map("seller_services")
}

model OfferService {
  id        String        @id @default(uuid())
  offerId   String
  offer     Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  serviceId String
  service   SellerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([offerId, serviceId])
  @@map("offer_services")
}

model StockMovement {
  id             String            @id @default(uuid())
  offerId        String
  offer          Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  movementType   StockMovementType
  quantityChange Decimal           // Positif (+ ajout) ou négatif (- déduction)
  previousStock  Decimal
  newStock       Decimal
  referenceType  String?           // SUB_ORDER, MANUAL_AUDIT, RETURN, RESTOCK
  referenceId    String?           // Id de la sous-commande ou du bon de livraison
  notes          String?
  createdByUserId String?
  createdAt      DateTime          @default(now())

  @@index([offerId])
  @@index([sellerId])
  @@map("stock_movements")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  saleType  SaleType @default(RETAIL)
  quantity  Decimal  @default(1.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, offerId, saleType])
  @@map("cart_items")
}

model ParentOrder {
  id                   String            @id @default(uuid())
  orderNumber          String            @unique // AGC-ORD-202611-XXXX
  buyerId              String
  buyer                User              @relation("BuyerOrders", fields: [buyerId], references: [id])
  status               ParentOrderStatus @default(PENDING)
  
  // Taux de change historique figé au moment exact de la commande
  exchangeRateSnapshot Decimal           // 1 USD = X CDF
  currency             Currency          @default(CDF)
  
  totalItemsCdf        Decimal           @default(0.00)
  totalItemsUsd        Decimal           @default(0.00)
  deliveryFeeCdf       Decimal           @default(0.00)
  deliveryFeeUsd       Decimal           @default(0.00)
  totalAmountCdf       Decimal           @default(0.00)
  totalAmountUsd       Decimal           @default(0.00)

  // Coordonnées de livraison en RDC
  deliveryProvince     String
  deliveryCity         String
  deliveryCommune      String?
  deliveryAddress      String
  recipientName        String
  recipientPhone       String
  deliveryInstructions String?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  subOrders            SubOrder[]
  payments             PaymentTransaction[]

  @@map("parent_orders")
}

model SubOrder {
  id                  String           @id @default(uuid())
  subOrderNumber      String           @unique // AGC-SUB-202611-XXXX-X
  parentOrderId       String
  parentOrder         ParentOrder      @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              SellerProfile    @relation(fields: [sellerId], references: [id])
  status              SubOrderStatus   @default(PENDING)
  
  subtotalCdf         Decimal          @default(0.00)
  subtotalUsd         Decimal          @default(0.00)
  commissionRate      Decimal          @default(5.00) // Taux de commission AgroConnect (ex: 5%)
  commissionAmountCdf Decimal          @default(0.00)
  commissionAmountUsd Decimal          @default(0.00)
  payoutAmountCdf     Decimal          @default(0.00) // Part nette due au vendeur
  payoutAmountUsd     Decimal          @default(0.00)
  payoutStatus        PayoutStatus     @default(PENDING)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items               OrderItem[]
  delivery            Delivery?
  payouts             SellerPayout[]
  financialRecord     FinancialRecord?

  @@index([sellerId])
  @@index([parentOrderId])
  @@map("sub_orders")
}

model OrderItem {
  id           String        @id @default(uuid())
  subOrderId   String
  subOrder     SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  offerId      String
  offer        Offer         @relation(fields: [offerId], references: [id])
  saleType     SaleType      @default(RETAIL)
  quantity     Decimal
  unitPriceCdf Decimal
  unitPriceUsd Decimal
  subtotalCdf  Decimal
  subtotalUsd  Decimal
  createdAt    DateTime      @default(now())

  @@map("order_items")
}

model PaymentTransaction {
  id                    String              @id @default(uuid())
  parentOrderId         String
  parentOrder           ParentOrder         @relation(fields: [parentOrderId], references: [id], onDelete: Cascade)
  provider              PaymentProviderType
  providerTransactionId String?             @unique
  idempotencyKey        String              @unique
  amountCdf             Decimal
  amountUsd             Decimal
  currency              Currency
  status                PaymentStatus       @default(PENDING)
  verifiedAt            DateTime?
  rawResponse           String?             // JSON brut pour audit et traçabilité
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("payment_transactions")
}

model Delivery {
  id                  String               @id @default(uuid())
  subOrderId          String               @unique
  subOrder            SubOrder             @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  personnelId         String?
  personnel           DeliveryProfile?     @relation("PersonnelDeliveries", fields: [personnelId], references: [id])
  status              DeliveryStatus       @default(PENDING)
  trackingCode        String               @unique // AGC-TRK-XXXXXX
  pickupProvince      String
  pickupCity          String
  pickupAddress       String
  dropoffProvince     String
  dropoffCity         String
  dropoffAddress      String
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  statusHistory       DeliveryStatusHistory[]

  @@map("deliveries")
}

model DeliveryStatusHistory {
  id         String         @id @default(uuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  notes      String?
  location   String?
  recordedBy String?
  createdAt  DateTime       @default(now())

  @@index([deliveryId])
  @@map("delivery_status_history")
}

model ExchangeRateConfig {
  id                 String    @id @default(uuid())
  baseCurrency       Currency  @default(USD)
  targetCurrency     Currency  @default(CDF)
  rate               Decimal   // Ex: 2850.00 (1 USD = 2850 CDF)
  isActive           Boolean   @default(true)
  source             String    @default("MANUAL_CONFIG")
  effectiveFrom      DateTime  @default(now())
  configuredByUserId String?
  configuredByName   String?
  notes              String?
  createdAt          DateTime  @default(now())

  @@map("exchange_rate_configs")
}

model FinancialRecord {
  id                  String       @id @default(uuid())
  subOrderId          String       @unique
  subOrder            SubOrder     @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              SellerProfile @relation(fields: [sellerId], references: [id])
  parentOrderId       String
  grossAmountCdf      Decimal
  grossAmountUsd      Decimal
  commissionRate      Decimal      // Ex: 5.00
  commissionAmountCdf Decimal
  commissionAmountUsd Decimal
  sellerEarningsCdf   Decimal
  sellerEarningsUsd   Decimal
  exchangeRateApplied Decimal      // Snapshot du taux
  status              PayoutStatus @default(PENDING)
  recordedAt          DateTime     @default(now())
  payoutRef           String?
  paidAt              DateTime?

  @@index([sellerId])
  @@map("financial_records")
}

model SellerPayout {
  id         String       @id @default(uuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id])
  subOrderId String
  subOrder   SubOrder     @relation(fields: [subOrderId], references: [id])
  amountCdf  Decimal
  amountUsd  Decimal
  status     PayoutStatus @default(PENDING)
  paidAt     DateTime?
  reference  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("seller_payouts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
